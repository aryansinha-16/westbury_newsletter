# Copy to .env (never commit .env). Set the SAME vars on Railway.
ANTHROPIC_API_KEY=
SERPER_API_KEY=

# Comma-separated recipient list
NEWSLETTER_RECIPIENTS=aryan@valuecart.in

# Fine-grained GitHub PAT — MUST have "Contents: Read and write" on the repo.
# A read-only token loads history but every save fails 403 and dedup dies.
GITHUB_TOKEN=

# Optional overrides (defaults shown):
# GITHUB_REPO=aryansinha-16/westbury_newsletter
# GITHUB_BRANCH=master
